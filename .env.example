# Copy this file to .env for Docker Compose. Do not commit .env.
DB_NAME=devpilot
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-unique-local-password
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/devpilot

# Required by the backend. Set these in your IDE/run environment as well;
# Spring Boot does not load a root .env file automatically.
NVIDIA_API_KEY=replace-with-your-nvidia-api-key
GITHUB_CLIENT_ID=replace-with-your-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-client-secret
TOKEN_ENCRYPTOR_PASSWORD=replace-with-a-long-random-secret
TOKEN_ENCRYPTOR_SALT=replace-with-a-unique-random-salt

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
